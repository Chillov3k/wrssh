server {
    listen 80;
    server_name ${WEB_DOMAIN};
    return 301 https://$host${WEB_HTTPS_PORT_SUFFIX}$request_uri;
}

server {
    listen 443 ssl;
    server_name ${WEB_DOMAIN};

    ssl_certificate ${WEB_TLS_CERT_PATH};
    ssl_certificate_key ${WEB_TLS_KEY_PATH};
    ssl_session_timeout 1d;
    ssl_session_cache shared:wrssh_ssl_cache:10m;
    ssl_session_tickets off;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    resolver 127.0.0.11 valid=10s ipv6=off;
    set $platform_upstream platform:8080;
    add_header Cache-Control "no-store, no-cache, must-revalidate" always;
    add_header Pragma "no-cache" always;
    add_header Expires "0" always;

    root /usr/share/nginx/html;
    index index.html;

    location = /_auth_session {
        internal;
        proxy_pass http://$platform_upstream/api/auth/me;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_send_timeout 15s;
        proxy_read_timeout 15s;
    }

    location = / {
        return 404;
    }

    location = ${WRSSH_ENTRY_PATH} {
        return 302 ${WRSSH_ENTRY_PATH}/projects;
    }

    location = ${WRSSH_ENTRY_PATH}/ {
        return 302 ${WRSSH_ENTRY_PATH}/projects;
    }

    location ^~ ${WRSSH_ENTRY_PATH}/api/ {
        rewrite ^${WRSSH_ENTRY_PATH}(/api/.*)$ $1 break;
        proxy_pass http://$platform_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_send_timeout 180s;
        proxy_read_timeout 180s;
    }

    location ^~ ${WRSSH_ENTRY_PATH}/ws/ {
        rewrite ^${WRSSH_ENTRY_PATH}(/ws/.*)$ $1 break;
        proxy_pass http://$platform_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_send_timeout 180s;
        proxy_read_timeout 180s;
    }

    location ~ ^${WRSSH_ENTRY_PATH}/(?:(projects|project-create|project-edit|users|user-edit|overview|hosts|host|builds|downloads|download|profile)|styles\.css|theme-init\.js|[^/]+\.js|[^/]+\.png|favicon\.ico)$ {
        rewrite ^${WRSSH_ENTRY_PATH}(/.*)$ $1 break;
        try_files $uri $uri.html =404;
    }

    location / {
        return 404;
    }
}
